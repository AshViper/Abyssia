    for d in (os.path.join(ASSETS, "blockstates"), os.path.join(ASSETS, "models"), BLOCK_TEX, ITEM_TEX,
              os.path.join(DATA, "abyssia", "loot_tables", "blocks"), os.path.join(DATA, "abyssia", "loot_tables", "harvest"),
