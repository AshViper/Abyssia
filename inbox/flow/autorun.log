+    stairs, slab = stem + "_stairs", stem + "_slab"
+    tex = ref(stem)
+    for suffix, parent in (("", "stairs"), ("_inner", "inner_stairs"), ("_outer", "outer_stairs")):
+        write(bm(stairs + suffix), {"parent": "minecraft:block/" + parent,
