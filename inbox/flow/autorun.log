def soft_dot(size, radius, rgb, core=None):
    c = Canvas(size)
    ctr = (size - 1) / 2
    for y in range(size):
        for x in range(size):
            d = ((x - ctr) ** 2 + (y - ctr) ** 2) ** 0.5
            a = max(0.0, min(1.0, radius - d + 0.5))
            if a > 0:
                c.put(x, y, core if core and d < radius * 0.4 else rgb, int(255 * a))
    return c


