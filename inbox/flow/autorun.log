        write(bs(name), {"variants": {"": {"model": ref(name)}}})
        write(bm(name), cross_model(ref(name), ref(name + "_glow") if glow else None))
        write(im(name), {"parent": "minecraft:item/generated", "textures": {"layer0": ref(name)}})

