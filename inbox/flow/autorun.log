+    write(bm(slab + "_top"), {"parent": "minecraft:block/slab_top", "textures": {"bottom": tex, "top": tex, "side": tex}})
+    write(bs(slab), building_assets.slab_blockstate(ref(slab), ref(slab + "_top"), ref(stem)))
+    write(im(slab), {"parent": ref(slab)})
+
