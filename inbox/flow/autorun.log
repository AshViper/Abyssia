diff --git a/src/main/java/com/abyssia/item/ModTools.java b/src/main/java/com/abyssia/item/ModTools.java
new file mode 100644
index 0000000000000000000000000000000000000000..bd0e4747ea74c07276d0abfb2ae9e0b6d6d5f627
